# ==============================================================
# DEFOPS BACKEND PRODUCTION ENVIRONMENT VARIABLES (Render)
# ==============================================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret Key
JWT_SECRET=supersecretmilitarykey2026_change_in_production

# MongoDB Connection String (Atlas or Cloud Mongo)
# In Zero Area Networks, backend will safely fallback to in-memory store if DB is offline
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/defops?retryWrites=true&w=majority

# Frontend Client URL for CORS Whitelisting (Optional, default allows all origins)
CLIENT_URL=https://your-frontend.vercel.app
